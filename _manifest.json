{
  "manifest_version": 2,
  "version": "3.11.0",
  "name": "Mittes 的一天 (A Day With Mittes)",
  "description": "为 Mittes 提供每日生成的日程、状态与话题，支持按日程唤醒私聊 planner，以及用户按需请求的二次元手机随拍；拍照通过 CPA 后台生成并检查，完整过程与图片归档。另含日程管理页、穿搭查询、天气与节假日识别。",
  "author": {
    "name": "Mittes",
    "url": "https://github.com/Mittes0214"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/Mittes0214/a-day-with-mittes",
    "homepage": "https://github.com/Mittes0214/a-day-with-mittes",
    "documentation": "https://github.com/Mittes0214/a-day-with-mittes",
    "issues": "https://github.com/Mittes0214/a-day-with-mittes/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {"type": "python_package", "name": "httpx", "version_spec": ">=0.28.1"},
    {"type": "python_package", "name": "Pillow", "version_spec": ">=11.0.0"}
  ],
  "capabilities": [
    "config.get",
    "config.get_plugin",
    "config.get_all",
    "llm.generate",
    "chat.get_stream_by_group_id",
    "chat.open_session",
    "maisaka.proactive.trigger",
    "maisaka.context.append",
    "message.get_by_id",
    "message.get_recent",
    "send.image",
    "send.text",
    "http.request"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "khiqwq.a-day-with-mittes"
}
