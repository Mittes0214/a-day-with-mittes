{
  "manifest_version": 2,
  "version": "3.5.0",
  "name": "Mittes 的一天 (A Day With Mittes)",
  "description": "为 Mittes 提供会自己长出来的日程：每天批量生成变长时段的故事化状态，事实层走 Tool 按需提供，状态层（心情、忙碌度、说话方式）常驻注入 planner 与 replyer。另含实时天气查询与节假日识别。",
  "author": {
    "name": "Mittes",
    "url": "https://github.com/Mittes0214"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/Mittes0214/a-day-with-mittes",
    "homepage": "https://github.com/Mittes0214/a-day-with-mittes",
    "documentation": "https://github.com/Mittes0214/a-day-with-mittes",
    "issues": "https://github.com/Mittes0214/a-day-with-mittes/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "config.get",
    "config.get_plugin",
    "config.get_all",
    "llm.generate",
    "chat.get_stream_by_group_id",
    "send.text",
    "http.request"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "khiqwq.a-day-with-mittes"
}